# Export these settings before starting the service; .env is not auto-loaded.
# Use a random ASCII token of at least 32 characters. The placeholder is rejected.
# Without a valid token, liveness works but models are not loaded/readiness is 503.
# Private inference routes will use this token; no classify route exists yet.
ML_INTERNAL_TOKEN=replace-with-a-generated-secret
# Relative to the working directory (run commands with --directory ml).
ML_MODEL_DIR=./models
