# Copy to web/.env.local. Never commit project credentials.
NEXT_PUBLIC_SUPABASE_URL=https://yruyulqwyalxmtseaoml.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_project_publishable_key
# Configure Supabase Auth site URL + redirect allowlist to include this origin
# and /auth/callback for email confirmation and password recovery.
APP_URL=http://localhost:3000

# Studbot: server-only settings; use the same randomly generated token in FastAPI.
# For deployment, APP_URL must be the public HTTPS website origin.
# A remote classifier must use HTTPS. Loopback HTTP works on a shared server.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_INTERNAL_TOKEN=replace-with-a-generated-secret

# Server only: needed to persist verified study observations and award tokens.
# Apply supabase/migrations/20261115000100_studbot_rewards.sql first.
SUPABASE_SECRET_KEY=replace_with_server_secret_key
